{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmuc",
  "account_id": "dfb8e2f3cce1c0e0425c071aa4537068",
  "main": "./worker.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RANKINGS", "class_name": "RankingStore" }
    ]
  },
  "r2_buckets": [
    { "binding": "CHALLENGE_FILES", "bucket_name": "gmuc-challenge-files" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RankingStore"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
