{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aibookrecommend",
  "main": "./worker.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RANKINGS", "class_name": "RankingStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RankingStore"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
